#!/bin/sh
# Output for waybar custom/record module. Emits nothing (and waybar hides the
# module via exec-if) when gpu-screen-recorder is not running.

if ! pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
    exit 1
fi

rec_start=$(stat -c %Y /tmp/omarchy-screenrecord-filename 2>/dev/null)
[ -n "$rec_start" ] || exit 1

now=$(date +%s)
elapsed=$((now - rec_start))
mins=$((elapsed / 60))
secs=$((elapsed % 60))

printf '<span color="#ff3b30">●</span> %02d:%02d' "$mins" "$secs"
