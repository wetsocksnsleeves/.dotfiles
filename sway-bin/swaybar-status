#!/bin/sh

width=${1:-2560}
output=${2:-DP-1}

c_text="#e8e8e8"
c_dim="#c8ccd4"

echo '{"version":1,"click_events":true}'
echo '['

exec 3<&0
(while read -r event <&3; do
    name=$(printf '%s' "$event" | sed 's/^,//' | jq -r 'if type=="array" then .[0] else . end | .name // empty' 2>/dev/null)
    if [ "$name" = "volume" ]; then
        swaymsg exec -- ghostty --title=pulsemixer --background-opacity=0.99 -e pulsemixer >/dev/null 2>&1
    elif [ "$name" = "screenrecord" ]; then
        $HOME/.local/bin/capture-screenrecording --stop-recording >/dev/null 2>&1 &
    fi
done) &

while true; do
    volume=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n1)
    muted=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes' && echo muted || echo unmuted)

    if [ "$muted" = "muted" ]; then
        icon="  "
        color="$c_dim"
    elif [ "${volume%\%}" -le 50 ]; then
        icon="  "
        color="$c_text"
    else
        icon="  "
        color="$c_text"
    fi

    vol_block="{\"name\":\"volume\",\"markup\":\"pango\",\"full_text\":\"<span size='15pt'>${icon}</span>\",\"color\":\"$color\",\"separator\":false}"

    rec_block=""
    if pgrep -f "^gpu-screen-recorder" >/dev/null 2>&1; then
        rec_start=$(stat -c %Y /tmp/omarchy-screenrecord-filename 2>/dev/null)
        if [ -n "$rec_start" ]; then
            now=$(date +%s)
            elapsed=$((now - rec_start))
            mins=$((elapsed / 60))
            secs=$((elapsed % 60))
            dur=$(printf '%02d:%02d' "$mins" "$secs")
            rec_block="{\"name\":\"screenrecord\",\"markup\":\"pango\",\"full_text\":\"<span color='#ff3b30'>●</span> $dur\",\"color\":\"$c_text\",\"separator\":false}"
        fi
    fi

    time_text=$(date +'%b %d %a %X')
    ws_count=$(swaymsg -t get_workspaces 2>/dev/null | jq --arg o "$output" '[.[] | select(.output==$o)] | length' 2>/dev/null)
    if [ -z "$ws_count" ] || [ "$ws_count" -eq 0 ] 2>/dev/null; then
        ws_count=5
    fi
    left=$((ws_count * 22))
    right=45
    min_width=$((width - 2 * left))
    [ "$min_width" -lt 0 ] && min_width=0
    spacer=$((left - right))
    [ "$spacer" -lt 0 ] && spacer=0

    time_block="{\"full_text\":\"$time_text\",\"color\":\"$c_text\",\"align\":\"center\",\"min_width\":$min_width,\"separator\":false}"
    spacer_block="{\"full_text\":\"\",\"min_width\":$spacer,\"separator\":false}"

    blocks="[$time_block,$vol_block,$spacer_block]"
    if [ -n "$rec_block" ]; then
        blocks="[$time_block,$rec_block,$vol_block,$spacer_block]"
    fi
    echo "$blocks,"
    sleep 1
done
