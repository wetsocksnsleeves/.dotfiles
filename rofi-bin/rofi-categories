#!/usr/bin/env bash
choice=$(printf 'apps\nscreenrecord\nemoji\ncalc\npower\n' | rofi -dmenu -p 'menu')
case "$choice" in
  apps)         exec rofi -show drun ;;
  screenrecord) exec $HOME/.local/bin/rofi-screenrecord-menu ;;
  emoji)        exec rofi -modi emoji -show emoji -emoji-format '{emoji} {name}';;
  calc)         exec rofi -modi calc -show calc ;;
  power)        exec $HOME/.local/bin/rofi-power-menu ;;
  *)            exit 0 ;;
esac
